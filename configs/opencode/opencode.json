{
    "$schema": "https://opencode.ai/config.json",
    "autoupdate": true,
    "plugin": [
        "opencode-anthropic-login-via-cli@latest",
        "opencode-gemini-auth@latest"
    ],
    "mcp": {
        "context7": {
            "type": "remote",
            "url": "https://mcp.context7.com/mcp",
            "enabled": false
        },
        "engram": {
            "command": [
                "engram",
                "mcp",
                "--tools=agent"
            ],
            "enabled": true,
            "type": "local"
        },
        "codebase-memory-mcp": {
            "enabled": true,
            "type": "local",
            "command": [
                "codebase-memory-mcp"
            ]
        }
    },
    "agent": {
        "build": {
            "disable": true
        },
        "plan": {
            "disable": true
        }
    }
}
